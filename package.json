{
  "name": "vibe-design-studio",
  "version": "1.0.0",
  "description": "Headless Creative & Motion Design Studio for AI Agents (Remotion + React + Whisper)",
  "main": "src/index.tsx",
  "keywords": [
    "antigravity",
    "remotion",
    "claude-code",
    "vibe-design-studio",
    "design-studio",
    "ai-video",
    "motion-design",
    "whisper",
    "vibe-coding",
    "agent-skills"
  ],
  "author": "Gabriel Toledo <gabriel@gabrieltoledo.me>",
  "license": "MIT",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Video out/video.mp4 --codec=h264 --crf=16",
    "render:mastered": "remotion render Video out/video.mp4 --codec=h264 --crf=16 && node scripts/masterizar_audio.mjs out/video.mp4 out/video_mastered.mp4",
    "masterizar": "node scripts/masterizar_audio.mjs",
    "narrar": "node scripts/narrar.mjs",
    "criar:1click": "node scripts/pipeline_script_to_video.mjs",
    "criar:1click:horizontal": "node scripts/pipeline_script_to_video.mjs --aspect=16:9",
    "criar:1click:feed": "node scripts/pipeline_script_to_video.mjs --aspect=4:5",
    "lint:slop": "node scripts/lint-motion-slop.mjs",
    "review:frames": "node scripts/auto_revisar_frames.mjs",
    "bancada": "node scripts/produzir_video_bancada.mjs",
    "palavras": "node scripts/transcrever-palavras.mjs public/narracao.mp3 src/data/words.json pt",
    "check": "tsc -p .",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "node --test \"tests/e2e/*.test.mjs\" \"tests/adversarial/*.test.mjs\"",
    "test:py": "node scripts/run_py_tests.mjs",
    "test": "pnpm run check && pnpm run test:unit && pnpm run test:e2e && pnpm run test:py",
    "setup:pastas": "node scripts/preparar_pastas.mjs",
    "assets:check": "node scripts/check_assets.mjs",
    "cortar:silencio": "node scripts/cortar_silencio.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "8.17.10",
    "@remotion/bundler": "4.0.300",
    "@remotion/captions": "4.0.300",
    "@remotion/cli": "4.0.300",
    "@remotion/google-fonts": "4.0.300",
    "@remotion/install-whisper-cpp": "4.0.300",
    "@remotion/renderer": "4.0.300",
    "@remotion/three": "4.0.300",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.300",
    "three": "0.169.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/three": "0.169.0",
    "typescript": "5.6.3"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  }
}
